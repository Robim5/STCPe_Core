# url da api da STCP
STCP_API_URL=

# chave opcional para proteger os endpoints /api/*
API_KEY=

# em producao, se true e API_KEY tiver vazia, os endpoints /api/* devolvem 503
REQUIRE_API_KEY_IN_PRODUCTION=true

# menos seguro, ela permite autenticar por query param (?api_key=...)
ALLOW_API_KEY_QUERY_PARAM=false

# segredo para endpoint interno /api/internal/refresh
# usar no header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ligacao principal PostgreSQL (Supabase)
DATABASE_URL=

# SSL ativo por defeito
DB_SSL=true
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# intervalo minimo entre refreshes por pedido (segundos)
STCP_REFRESH_INTERVAL_SECONDS=15

# recomendado no Railway (worker web persistente)
# em local, podes desativar se preferires
ENABLE_BACKGROUND_POLLING=true
STCP_BACKGROUND_INTERVAL_SECONDS=10

# CORS (origens separadas por virgula)
CORS_ALLOW_ORIGINS=https://teu-frontend.com

# headers HTTP de seguranca
SECURITY_HEADERS_ENABLED=true

# rate limit basico por IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# opcional: forca modo producao manualmente
# IS_PRODUCTION=true

# fallback opcional caso nao uses DATABASE_URL
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=postgres
