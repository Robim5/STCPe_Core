# url da api da STCP
STCP_API_URL=

# chave opcional para proteger os endpoints /api/*
API_KEY=

# em producao, se true e API_KEY tiver vazia, os endpoints /api/* devolvem 503
REQUIRE_API_KEY_IN_PRODUCTION=true

# menos seguro, ela permite autenticar por query param (?api_key=...)
ALLOW_API_KEY_QUERY_PARAM=false

# segredo para endpoint interno /api/internal/refresh
# usar no header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ligacao principal PostgreSQL (Supabase)
DATABASE_URL=

# SSL ativo por defeito
DB_SSL=true
# se o provedor apresentar cadeia self-signed, permite SSL sem validar CA
# (usar false apenas quando necessario)
DB_SSL_VERIFY=true
# opcional: caminho para CA custom (se fornecida pelo provedor)
# DB_SSL_CA_FILE=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# intervalo minimo entre refreshes por pedido (segundos); alinhar com o intervalo do cron
STCP_REFRESH_INTERVAL_SECONDS=15

# loop interno a cada STCP_BACKGROUND_INTERVAL_SECONDS (mais CPU no Railway)
# producao: false + cron externo em GET /api/internal/refresh (ver README)
ENABLE_BACKGROUND_POLLING=false
STCP_BACKGROUND_INTERVAL_SECONDS=10

# CORS (origens separadas por virgula)
CORS_ALLOW_ORIGINS=https://teu-frontend.com

# headers HTTP de seguranca
SECURITY_HEADERS_ENABLED=true

# rate limit basico por IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# opcional: forca modo producao manualmente
# IS_PRODUCTION=true

# fallback opcional caso nao uses DATABASE_URL
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=postgres
